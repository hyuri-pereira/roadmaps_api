# =====================================================================
#  GERENCIADOR DE ROADMAP + ASANA - configuracao da API
#  Copie este arquivo para ".env" e preencha os valores.
#  Tudo marcado como <preencher> e obrigatorio para o sistema subir.
#
#  No Docker (../docker-compose.yml) as URLs publicas, o FIREBIRD_* e o
#  WAHA_BASE_URL sao definidos pelo compose e sobrescrevem este arquivo.
# =====================================================================

# ---------------------------------------------------------------------
# 1. APLICACAO
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5045
# Prefixo global das rotas (ex.: /api/roadmaps)
API_PREFIX=api
# URL publica da API (usada em callbacks OAuth, webhooks e links de arquivo).
# Precisa ser HTTPS e alcancavel pela internet para o webhook do Asana funcionar.
APP_PUBLIC_URL=http://localhost:5045
# URL do frontend (destino do redirect apos o login Google)
FRONTEND_URL=http://localhost:5050
# Origens liberadas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5050
# Publica o Swagger em {API_PREFIX}/docs
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------
# 2. BANCO DE DADOS - FIREBIRD 5.0
# ---------------------------------------------------------------------
# Driver de acesso:
#   pure   = biblioteca "node-firebird" (protocolo TCP puro, sem DLL) -> EM USO
#            Nao implementa wire encryption, por isso o firebird.conf do FB 5.0
#            precisa estar com "WireCrypt = Enabled" (o padrao vem "Required").
#   native = "node-firebird-driver-native" (carrega fbclient.dll no processo Node).
#            SO funciona se o fbclient.dll tiver a MESMA arquitetura do Node.
#            O Firebird instalado esta em "Program Files (x86)" = 32 bits e o
#            Node e x64: para usar "native" e preciso um fbclient.dll de 64 bits
#            e compilar o node-firebird-native-api (node-gyp + Build Tools).
FIREBIRD_DRIVER=pure

FIREBIRD_HOST=127.0.0.1
# ATENCAO: nesta maquina a porta 3050 e do Firebird 2.5 (outra instalacao).
# O Firebird 5.0 escuta na 3055 (RemoteServicePort do firebird.conf).
FIREBIRD_PORT=3055
# Caminho do arquivo .FDB no SERVIDOR Firebird
FIREBIRD_DATABASE=C:\Web\TotalProjetos\api\db\ROADMAP.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=<preencher>
FIREBIRD_CHARSET=UTF8
# Tamanho de pagina usado ao criar o banco (npm run db:create)
FIREBIRD_PAGE_SIZE=8192
# Pool de conexoes
FIREBIRD_POOL_MAX=10
FIREBIRD_CONNECT_TIMEOUT_MS=15000
# Usuario de runtime com privilegios minimos (crie no banco e use aqui em producao).
# Deixe vazio para reutilizar FIREBIRD_USER / FIREBIRD_PASSWORD.
FIREBIRD_RUNTIME_USER=
FIREBIRD_RUNTIME_PASSWORD=
# Somente para FIREBIRD_DRIVER=native: pasta que contem o fbclient.dll (64 bits)
FIREBIRD_NATIVE_CLIENT_PATH=

# ---------------------------------------------------------------------
# 3. SEGURANCA / CRIPTOGRAFIA
# ---------------------------------------------------------------------
# Chave AEAD (AES-256-GCM) usada para cifrar tokens do Asana, API key do WAHA
# e a senha SMTP. 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=<preencher>
# Identificador da chave gravado na coluna VERSAO_CHAVE (permite rotacao)
ENCRYPTION_KEY_VERSION=v1
# Chaves antigas, para decifrar dados durante uma rotacao.
# Formato: versao:chaveBase64 (varias separadas por virgula)
ENCRYPTION_KEYS_LEGACY=

# Segredo dos JWT. Gere com o mesmo comando acima.
JWT_SECRET=<preencher>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=roadmap-api

# ---------------------------------------------------------------------
# 4. LOGIN COM GOOGLE (OAuth 2.0)
# ---------------------------------------------------------------------
# Credenciais em https://console.cloud.google.com/apis/credentials
# Tipo: ID do cliente OAuth -> Aplicativo da Web.
# Em "URIs de redirecionamento autorizados" cadastre exatamente GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=<preencher>
GOOGLE_CLIENT_SECRET=<preencher>
GOOGLE_CALLBACK_URL=http://localhost:5045/api/auth/google/callback
# Restringe o login a dominios especificos (separados por virgula). Vazio = qualquer.
GOOGLE_ALLOWED_DOMAINS=
# Permite que um usuario ainda nao cadastrado crie a propria conta no primeiro login
GOOGLE_AUTO_PROVISION=true

# ---------------------------------------------------------------------
# 5. ASANA - OAuth 2.0 e PAT
# ---------------------------------------------------------------------
# Cada gestor escolhe: colar o proprio Personal Access Token (PAT)
# ou autorizar via OAuth. O OAuth exige app registrado em
# https://app.asana.com/0/my-apps
ASANA_OAUTH_CLIENT_ID=
ASANA_OAUTH_CLIENT_SECRET=
# O Asana exige HTTPS para callbacks de apps web; cadastre exatamente a mesma URL no Developer Console.
ASANA_OAUTH_REDIRECT_URI=https://api.seudominio.com/api/asana-conexoes/oauth/callback
ASANA_API_BASE_URL=https://app.asana.com/api/1.0
ASANA_OAUTH_AUTHORIZE_URL=https://app.asana.com/-/oauth_authorize
ASANA_OAUTH_TOKEN_URL=https://app.asana.com/-/oauth_token
# Escopos. "default" = acesso completo do usuario que autorizou.
ASANA_OAUTH_SCOPES=default
# Limite de requisicoes por minuto por conexao (o Asana permite ~150/min)
ASANA_RATE_LIMIT_PER_MINUTE=140
ASANA_HTTP_TIMEOUT_MS=20000

# Nomes usados apenas para localizar os projetos na primeira configuracao.
# Depois disso o sistema sempre opera por GID.
ASANA_PROJETO_SPRINT_NOME=SPRINT
ASANA_PROJETO_BACKLOG_NOME=Backlog
ASANA_SECAO_SPRINT_PADRAO=A fazer
ASANA_SECAO_BACKLOG_PADRAO=Refino

# ---------------------------------------------------------------------
# 6. WEBHOOKS DO ASANA
# ---------------------------------------------------------------------
# O Asana faz POST nesta URL. Precisa ser HTTPS publico.
ASANA_WEBHOOK_URL=https://seu-dominio.com/api/asana-webhooks/receber
# Registra webhooks automaticamente ao configurar a equipe
ASANA_WEBHOOK_AUTO_REGISTER=true
# Reconciliacao periodica das tarefas (cron de 6 campos). Padrao: a cada 15 min.
ASANA_RECONCILIACAO_CRON=0 */15 * * * *
# Sincronizacao do catalogo (workspaces/equipes/projetos/secoes). Padrao: de hora em hora. "off" desliga.
ASANA_CATALOGO_SYNC_CRON=0 0 * * * *

# ---------------------------------------------------------------------
# 7. WORKERS / FILAS
# ---------------------------------------------------------------------
WORKERS_ENABLED=true
# Identificador desta instancia (aparece em BLOQUEADO_POR). Vazio = hostname+pid.
WORKER_ID=
INTEGRACAO_WORKER_CRON=*/10 * * * * *
INTEGRACAO_WORKER_LOTE=10
INTEGRACAO_WORKER_LEASE_SEGUNDOS=120
INTEGRACAO_MAX_TENTATIVAS=8
NOTIFICACAO_WORKER_CRON=*/15 * * * * *
NOTIFICACAO_WORKER_LOTE=10
NOTIFICACAO_WORKER_LEASE_SEGUNDOS=120
NOTIFICACAO_MAX_TENTATIVAS=6
# Backoff exponencial: espera = BASE * 2^tentativa, limitado por MAX
RETRY_BACKOFF_BASE_SEGUNDOS=15
RETRY_BACKOFF_MAX_SEGUNDOS=3600

# ---------------------------------------------------------------------
# 8. E-MAIL (SMTP padrao do sistema)
# ---------------------------------------------------------------------
# Estes valores populam a tabela EMAIL_CONFIG no primeiro boot (id fixo = 1).
# Depois podem ser alterados em PUT /api/notificacoes/email-config (perfil ADMIN).
MAIL_ENABLED=true
MAIL_HOST=smtp.seuprovedor.com
MAIL_PORT=587
# TLS (porta 465) ou STARTTLS (porta 587)
MAIL_SECURITY=STARTTLS
MAIL_USER=<preencher>
MAIL_PASSWORD=<preencher>
MAIL_FROM_EMAIL=roadmap@suaempresa.com
MAIL_FROM_NAME=Gerenciador de Roadmap
# false desativa a validacao do certificado TLS (use apenas em ambiente interno)
MAIL_TLS_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------
# 9. WHATSAPP VIA WAHA
# ---------------------------------------------------------------------
# Servidor WAHA padrao, cadastrado automaticamente no primeiro boot.
WAHA_ENABLED=true
WAHA_NOME=WAHA Principal
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=<preencher>
# Segredo para validar os webhooks que o WAHA envia de volta (opcional)
WAHA_WEBHOOK_SECRET=
# URL que o WAHA chama ao mudar o status da sessao (opcional)
WAHA_WEBHOOK_URL=https://seu-dominio.com/api/waha/webhook
# Prefixo do nome da sessao de cada gestor: <prefixo>-<idUsuario>
WAHA_SESSION_PREFIX=gestor
WAHA_HTTP_TIMEOUT_MS=30000
# Codigo do pais para normalizar numeros digitados sem o "+" (Brasil = 55)
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# ---------------------------------------------------------------------
# 10. ARQUIVOS DE REFERENCIA DOS CARDS
# ---------------------------------------------------------------------
# Arquivos NAO ficam no Firebird. Sao gravados em disco e servidos por rota
# autenticada e duravel: {APP_PUBLIC_URL}/{API_PREFIX}/cards/referencias/:id/download
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/referencias
STORAGE_MAX_FILE_MB=25
STORAGE_MIME_PERMITIDOS=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/csv,application/zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ---------------------------------------------------------------------
# 11. BOOTSTRAP DO PRIMEIRO ADMINISTRADOR
# ---------------------------------------------------------------------
# Criado no primeiro boot se a tabela USUARIOS estiver vazia.
BOOTSTRAP_ADMIN_EMAIL=<preencher>
BOOTSTRAP_ADMIN_NOME=Administrador
# Senha inicial para login local. Vazio = somente login Google.
BOOTSTRAP_ADMIN_SENHA=

# ---------------------------------------------------------------------
# 12. LOGS
# ---------------------------------------------------------------------
# error | warn | log | debug | verbose
LOG_LEVEL=log
# Grava requisicao/resposta do Asana em INTEGRACAO_LOGS (sempre sem tokens)
LOG_INTEGRACAO_PAYLOAD=true
